  "evolve": {
    "max_keywords": 60,
    "cycle_words": 25,
    "max_promote_per_cycle": 6,
    "new_words_per_cycle": 3,
    "min_term_titles": 8,
    "min_term_coverage": 0.02,
    "retire_bottom": 5,
    "retire_streak": 2,
    "rotate_slots": 3,
    "note_rotate": "每轮为'长期未采到的尾部词'预留的槽位数；否则高分词会永久占满子集",
    "min_keywords": 10,
    "note_min": "词库下限：低于此数不再淘汰，否则小词库会被'末尾淘汰'清空",
    "max_term_coverage": 0.12,
    "note_coverage": "候选词的标题覆盖率上限。过高的词（如「模板」19%、「更新」14%）是样板话术或过泛词，当独立搜索词没有价值；真正可用的品类名往往是**具体**的，覆盖率反而低。",
    "note_boundary": "boundary_rate 仅作参考列：实测无法区分真词与碎片（标题是关键词堆砌），不作为过滤条件。"
  },
